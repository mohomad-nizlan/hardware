# Local development (creates local.db automatically on first write)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Configure your public shop defaults
NEXT_PUBLIC_SHOP_CURRENCY=LKR
NEXT_PUBLIC_SHOP_LOCALE=en-LK
BUSINESS_TIMEZONE=Asia/Colombo
BUSINESS_UTC_OFFSET=+05:30

# Initial owner credentials: set temporarily before running npm run owner:setup
# Never commit a real password or deploy OWNER_PASSWORD.
OWNER_USERNAME=owner
OWNER_NAME=Shop Owner
OWNER_PASSWORD=
